{
  "name": "dicecloud",
  "version": "2.1.0",
  "description": "Online Realtime TTRPG Engine",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThaumRystra/DiceCloud"
  },
  "author": "Thaum Rystra",
  "scripts": {
    "serve": "meteor run --raw-logs --settings settings.json",
    "debug": "meteor --inspect",
    "bundle-viz": "meteor --extra-packages bundle-visualizer --production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "meteor test --driver-package meteortesting:mocha --port 3001 --raw-logs",
    "test:coverage": "COVERAGE=1 COVERAGE_OUT_LCOVONLY=1 COVERAGE_OUT_REMAP=1 COVERAGE_APP_FOLDER=$PWD/ meteor test --once --raw-logs --driver-package meteortesting:mocha",
    "test:watch:coverage": "COVERAGE=1 COVERAGE_OUT_LCOVONLY=1 COVERAGE_OUT_REMAP=1 COVERAGE_APP_FOLDER=$PWD/ TEST_WATCH=1 meteor test --raw-logs --driver-package meteortesting:mocha",
    "build": "meteor build ../build --architecture os.linux.x86_64"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.523.0",
    "@babel/runtime": "^7.23.9",
    "@chenfengyuan/vue-countdown": "^2.1.3",
    "@swc/helpers": "^0.5.17",
    "alea": "^1.0.1",
    "bcrypt": "^5.1.1",
    "chroma-js": "^2.4.2",
    "css-box-shadow": "^1.0.0-3",
    "cytoscape": "^3.28.1",
    "cytoscape-dagre": "^2.5.0",
    "cytoscape-klay": "^3.1.4",
    "dagre": "^0.8.5",
    "date-fns": "^4.1.0",
    "ddp-rate-limiter-mixin": "^1.1.10",
    "discord.js": "^14.26.2",
    "dompurify": "^2.4.7",
    "ignore": "^5.3.1",
    "ignore-styles": "^5.0.1",
    "lodash": "^4.17.20",
    "marked": "^4.3.0",
    "meteor-node-stubs": "^1.2.7",
    "minify-css-string": "^1.0.0",
    "mongodb": "^4.17.2",
    "moo": "^0.5.2",
    "nearley": "^2.19.1",
    "ngraph.graph": "^20.1.2",
    "ngraph.path": "^1.6.1",
    "pretty-bytes": "^6.1.1",
    "qrcode.vue": "^3.8.0",
    "sharp": "^0.33.2",
    "simpl-schema": "^1.13.1",
    "source-map-support": "^0.5.21",
    "speakingurl": "^14.0.1",
    "thumbhash": "^0.1.1",
    "type-fest": "^4.32.0",
    "vivagraphjs": "^0.12.0",
    "vue": "^3.5.0",
    "vue-draggable-plus": "^0.6.1",
    "vue-meteor-tracker": "^3.0.0-beta.7",
    "vue-router": "^4.5.0",
    "vuetify": "^3.12.5",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@meteorjs/rspack": "^1.1.0-beta.34",
    "@rsdoctor/rspack-plugin": "^1.5.7",
    "@rspack/cli": "^1.7.1",
    "@rspack/core": "^1.7.1",
    "@types/chai": "^4.3.11",
    "@types/lodash": "^4.14.202",
    "@types/meteor-mdg-validated-method": "^1.2.10",
    "@types/mocha": "^10.0.6",
    "@types/simpl-schema": "^1.12.7",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vue/compiler-dom": "^3.5.0",
    "@vue/runtime-dom": "^3.5.0",
    "chai": "^4.4.1",
    "eslint": "^10.2.0",
    "eslint-plugin-vue": "^10.8.0",
    "eslint-plugin-vuetify": "^2.7.2",
    "jiti": "^2.6.1",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.7",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.58.2",
    "vue-loader": "^17.4.2"
  },
  "meteor": {
    "mainModule": {
      "client": "client/main.js",
      "server": "server/main.js"
    },
    "modern": {
      "transpiler": {
        "verbose": false
      }
    }
  }
}
