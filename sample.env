# MongoDB Configuration
MONGO_USER=your_mongo_user                 # MongoDB username for authentication
MONGO_PASSWORD=your_mongo_password         # MongoDB password for authentication
MONGO_PORT=27017                           # MongoDB port number

# Node Performance Settings
NODE_OPTIONS=--max-old-space-size=512      # Node.js memory limit in MB
WEBAPP_THREAD_POOL_SIZE=2                  # Number of threads for the web application

# Node Environment Settings
NODE_ENV=production                       # Environment mode: production or development
NODE_MODULES_CACHE=true                   # Enable/disable Node modules caching
GZIP=true                                 # Enable/disable GZIP compression

# Meteor Configuration
METEOR_ALLOW_SUPERUSER=true               # Allow Meteor to run as superuser
METEOR_DISABLE_OPTIMISTIC_CACHING=true    # Disable Meteor's optimistic caching
METEOR_NO_RELEASE_CHECK=true              # Skip Meteor release version check
METEOR_DISABLE_OPLOG=false                # Enable/disable Meteor's oplog tailing

# Application Settings
ROOT_URL=http://0.0.0.0:3000              # Base URL for your application
PORT=3000                                 # Application port number

# Meteor Settings JSON
# Configure environment, Patreon integration, S3 storage and other meteor settings
METEOR_SETTINGS={"public":{"environment":"production","disablePatreon":false},"s3":{"key":"YOUR_S3_KEY","secret":"YOUR_S3_SECRET","bucket":"your-bucket-name","region":"your-region"}}

# Email Configuration
# Format: smtp://username:password@smtp.server.com:port
MAIL_URL=smtp://EMAIL:PASSWORD@SERVER:PORT
